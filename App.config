<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings"
                  type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <!--
        تم حذف القسم المكرر System_Clinic.My.MySettings
        وإبقاء القسم الصحيح الواحد فقط
      -->
      <section name="Managementclinic.My.MySettings"
               type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
               allowExeDefinition="MachineToLocalUser"
               requirePermission="false" />
    </sectionGroup>
  </configSections>

  <connectionStrings>
    <!--
      ملاحظة أمان:
      هذا الملف مرفق مع التطبيق ويجب ألا يُرفع لـ Git بدون حماية.
      في بيئة الإنتاج يُنصح بتشفير هذا القسم باستخدام:
        aspnet_regiis -pef "connectionStrings" "مسار التطبيق"
      أو استخدام Windows DPAPI عبر الكود.
    -->
    <add name="ClinicDBConnection"
         connectionString="Server=.;Database=clinicdb;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <userSettings>
    <Managementclinic.My.MySettings>

      <!-- ✅ إعدادات الواجهة — مسموح بحفظها -->
      <setting name="appbackcolor" serializeAs="String">
        <value />
      </setting>
      <setting name="appbackgroundimagepath" serializeAs="String">
        <value />
      </setting>
      <setting name="EnableRtl" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="ShowSlideshowBackground" serializeAs="String">
        <value>True</value>
      </setting>

      <!--
        ❌ حقول الجلسة أدناه تُبقى موجودة لأن My.Settings
           تتطلب تعريفها، لكن SessionManager يمسحها دائماً
           عند الحفظ ويرفض تحميلها — القيم هنا دائماً فارغة.
      -->
      <setting name="username" serializeAs="String">
        <value />
      </setting>
      <setting name="DoctorID" serializeAs="String">
        <value />
      </setting>
      <setting name="BranchID" serializeAs="String">
        <value />
      </setting>
      <setting name="userid" serializeAs="String">
        <value />
      </setting>
      <setting name="role" serializeAs="String">
        <value />
      </setting>

    </Managementclinic.My.MySettings>
  </userSettings>

</configuration>
